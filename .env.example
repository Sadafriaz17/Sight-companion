# ── Backend ───────────────────────────────────────────────────────────────────
# Port the Flask backend listens on (default: 5000)
PORT=5000
FLASK_DEBUG=0

# ── Supabase (backend) ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=server_only_secret  # only if a privileged backend op requires it

# ── Supabase (frontend / Vite) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the Sight Companion backend (no trailing slash)
VITE_API_URL=http://localhost:5000