# ── Backend (Flask) ───────────────────────────────────────────────────────────
# Port the Flask backend listens on (default: 5000 locally, 10000 on Render)
PORT=5000
FLASK_DEBUG=0

# ── Supabase (backend) ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_publishable_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key  # only if privileged ops needed

# ── Supabase (frontend / Vite build) ──────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_publishable_key_here

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the Flask backend (no trailing slash)
# Local development:
VITE_API_URL=http://localhost:5000
# Render production (replace with your actual backend service URL):
# VITE_API_URL=https://sight-companion-backend.onrender.com

# ── CORS (backend — production only) ─────────────────────────────────────────
# Your deployed frontend URL — added to the backend CORS whitelist.
# Set this on the backend Render service AFTER the frontend is deployed.
# FRONTEND_URL=https://sight-companion-frontend.onrender.com
